{
  "name": "spec-board",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "board": "npm run build -w @specboard/web --if-present && tsx packages/server/src/cli.ts",
    "specboard": "tsx packages/server/src/cli.ts",
    "web:dev": "npm run dev -w @specboard/web",
    "storybook": "npm run storybook -w @specboard/web",
    "test:claude": "npm run test:claude -w @specboard/server",
    "build:plugin": "npm run build -w @specboard/web && node scripts/build-plugin.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.20.5"
  }
}
