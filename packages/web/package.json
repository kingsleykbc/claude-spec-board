{
  "name": "@specboard/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@specboard/core": "*",
    "@storybook/addon-vitest": "9.1.21",
    "@storybook/react-vite": "9.1.21",
    "@types/node": "22.18.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/browser": "3.2.4",
    "happy-dom": "18.0.1",
    "playwright": "1.55.1",
    "storybook": "9.1.21",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
